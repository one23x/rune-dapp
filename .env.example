# ─── Supabase（主网） ─────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://mefjuecwawmjfmeofnck.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UBNS5SeIx7ZAhsR01NYQQQ_t86zzdXz

# 开户门控数据源:supabase(默认,读 rune_purchases/trading_auth_codes)| backend
# (回退到旧 engine GET /v1/node/status)。设 backend 可一键回滚旧门控,无需改代码。
VITE_NODE_GATING_SOURCE=supabase

# ─── thirdweb ─────────────────────────────────────────────────────────────────
VITE_THIRDWEB_CLIENT_ID=821adf6c06a2e527b87f32dd6c49e5b9

# Thirdweb Engine Relayer (gasless tx).
# - Relayer wallet ADDRESS is public (on-chain data) → safe in client bundle.
# - Relayer API KEY is a SECRET. It must NEVER appear in client bundle. Frontend
#   calls a Supabase Edge Function / cf-worker which holds the key server-side
#   and forwards signed requests to Thirdweb Engine.
VITE_THIRDWEB_RELAYER_ADDRESS=0x60b2aba282073b06d4914e8b71050443b82c6603
# THIRDWEB_RELAYER_KEY=  ← stored as GitHub Secret + Supabase Edge Function secret. NO VITE_ prefix.

# ─── Chain（主网） ───────────────────────────────────────────────────────────
#   bsc_mainnet  (chainId 56)
#   bsc_testnet  (chainId 97)
VITE_RUNE_CHAIN=bsc_mainnet
VITE_RUNE_COMMUNITY_MAINNET=
VITE_RUNE_NODE_PRESELL_MAINNET=

# ─── OpenRouter（AI 信号源用） ─────────────────────────────────────────────────
VITE_OPENROUTER_API=

# ─── One-Agents Engine（智能跟单后端） ─────────────────────────────────────────
# The Engine authenticates project routes with a Bearer PROJECT API KEY.
# A SPA must NEVER hold that key, so all engine calls go through a key-injecting
# proxy: Vite `server.proxy` in dev, the `engine-proxy` Supabase Edge Function
# in prod (see supabase/functions/engine-proxy/README.md).
#
# ONE_AGENTS_API_KEY is SERVER/PROXY-SIDE ONLY — NO VITE_ prefix, so it never
# enters the client bundle. In dev it is read by vite.config.ts (node context)
# and injected into the dev proxy; in prod it is a Supabase secret.
ONE_AGENTS_API_KEY=
ONE_AGENTS_API_BASE=https://api.one-agents.com
# Which proxy the SPA talks to. Dev default `/engine` (the Vite proxy). In prod
# set this to the Edge Function URL, e.g.
#   VITE_ENGINE_PROXY=https://<ref>.functions.supabase.co/engine-proxy
VITE_ENGINE_PROXY=/engine

# ─── 部署（仅本地脚本，不进入 bundle） ─────────────────────────────────────────
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN_1=
